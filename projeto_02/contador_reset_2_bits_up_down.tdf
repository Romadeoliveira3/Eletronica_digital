TITLE "Contador de 2 Bits com Detector de Borda e Reset";

-- Este subdesign cria um contador de 2 bits (0-3) que reage
-- a cada clique dos botões e pode ser zerado por um pino de reset.
SUBDESIGN contador_reset_2_bits_up_down
(
	-- ENTRADAS --
	clk_in        : INPUT;  -- Clock do sistema.
	reset_in      : INPUT;  -- Pino de reset (ativo em '1'). A borda de subida gera o pulso.
	botaoprox_in  : INPUT;  -- Botão para contar de forma CRESCENTE (UP).
	botaoant_in   : INPUT;  -- Botão para contar de forma DECRESCENTE (DOWN).
	
	-- SAÍDA --
	bit_out[1..0] : OUTPUT; -- Saída de 2 bits.
)
VARIABLE
	-- Registrador principal para 2 bits.
	q[1..0]            : DFF;
	
	-- Registradores para o detector de borda dos botões.
	btn1_reg, btn2_reg : DFF;
	
	-- Registrador para o detector de borda do sinal de reset.
	reset_reg          : DFF;
	
	-- Nós lógicos para os pulsos gerados.
	up_pulse, down_pulse : NODE;
	reset_pulse        : NODE; -- Pulso de reset gerado internamente.

BEGIN
	-- Sincroniza todos os registradores com o mesmo clock.
	q[].clk = clk_in;
	btn1_reg.clk = clk_in;
	btn2_reg.clk = clk_in;
	reset_reg.clk = clk_in;
	
	-- Conecta o valor do contador à porta de saída.
	bit_out[] = q[].q;
	
	-- Lógica do Detector de Borda para os botões.
	btn1_reg.d = botaoprox_in;
	btn2_reg.d = botaoant_in;
	up_pulse   = btn1_reg.q & !botaoprox_in;
	down_pulse = btn2_reg.q & !botaoant_in;
	
	-- Lógica do Detector de Borda para o reset_in.
	-- Gera um pulso de 1 ciclo quando reset_in vai de '0' para '1'.
	reset_reg.d = reset_in;
	reset_pulse = !reset_reg.q & reset_in;
	
	-- Lógica do Contador com Reset por Pulso.
	-- A condição de reset agora verifica apenas o pulso gerado internamente.
	IF reset_pulse == VCC THEN
		-- Se o pulso de reset estiver ativo, força o contador para zero.
		q[].d = 0;
	ELSE
		-- Se não houver pulso de reset, a lógica original de contagem é executada.
		IF up_pulse == VCC THEN
			q[].d = q[].q + 1;
		ELSE IF down_pulse == VCC THEN
			q[].d = q[].q - 1;
		ELSE
			q[].d = q[].q;
		END IF;
	END IF;
END IF;
END;