TITLE "Decodificador de Menus com Seleção";

-- Este subdesign implementa uma lógica de seleção em dois níveis.
-- O 'menu_in' escolhe o grupo de saídas e o 'select_in' escolhe a saída específica.
SUBDESIGN decodificador_menus
(
	-- ENTRADAS --
	menu_in[1..0]   : INPUT;  -- Seleciona o menu principal (00, 01, 10).
	select_in[1..0] : INPUT;  -- Seleciona a opção dentro do menu.
	
	-- SAÍDAS --
	-- Saídas ativadas pelo Menu 1
	crono1, crono2, crono3, crono4 : OUTPUT;
	
	-- Saídas ativadas pelo Menu 2
	digsel1, digsel2, digsel3, digsel4 : OUTPUT;
)
BEGIN
	-- Atribuição padrão: garante que todas as saídas comecem em '0' (desativadas)
	-- para evitar a criação de "latches" (estados de memória indesejados).
	(crono4, crono3, crono2, crono1) = B"0000";
	(digsel4, digsel3, digsel2, digsel1) = B"0000";

	-- O CASE principal verifica qual menu está ativo.
	CASE menu_in[] IS
	
		-- Se menu_in for "00" (Menu 1)...
		WHEN B"00" =>
			-- ...um segundo CASE verifica a seleção interna para ativar uma das saídas 'crono'.
			CASE select_in[] IS
				WHEN B"00" => crono1 = VCC;
				WHEN B"01" => crono2 = VCC;
				WHEN B"10" => crono3 = VCC;
				WHEN B"11" => crono4 = VCC;
			END CASE;
			
		-- Se menu_in for "01" (Menu 2)...
		WHEN B"01" =>
			-- ...um segundo CASE verifica a seleção interna para ativar uma das saídas 'digsel'.
			-- Note a ordem de ativação personalizada conforme solicitado.
			CASE select_in[] IS
				WHEN B"00" => digsel1 = VCC;
				WHEN B"01" => digsel4 = VCC;
				WHEN B"10" => digsel3 = VCC;
				WHEN B"11" => digsel2 = VCC;
			END CASE;
			
		-- Se menu_in for "10" (Menu 3)...
		--WHEN B"10" =>
			-- ======================================================================
			-- || ESPAÇO RESERVADO PARA A LÓGICA DO CONTADOR UP/DOWN DE 4 BITS     ||
			-- ||                                                                  ||
			-- || Neste modo, as saídas 'crono' e 'digsel' permanecerão em '0'     ||
			-- || por causa da atribuição padrão no início do bloco BEGIN.         ||
			-- ======================================================================
			
		-- Para todos os outros casos (neste caso, apenas "11").
		--WHEN OTHERS =>
			-- Nenhuma ação é necessária, pois a atribuição padrão já desativou todas as saídas.
			
	END CASE;
END;