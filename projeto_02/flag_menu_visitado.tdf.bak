TITLE "Flag de Visita ao Menu 4";

-- Este subdesign cria uma flag que é LIGADA quando o menu 4 ("11") é visitado
-- e DESLIGADA quando os menus 2 ("01") ou 3 ("10") são acessados.
SUBDESIGN flag_menu_visitado
(
	-- ENTRADAS --
	clk_in      : INPUT;      -- Clock para sincronizar a mudança de estado da flag.
	menu_in[1..0] : INPUT;      -- Entrada do menu atual.
	
	-- SAÍDA --
	comp_flag   : OUTPUT;     -- A flag de saída.
)
VARIABLE
	-- Usamos um D-Type Flip-Flop (DFF) para memorizar o estado da flag (0 ou 1).
	comp_flag_q : DFF;

BEGIN
	-- 1. Sincroniza o flip-flop da flag com o clock de entrada.
	comp_flag_q.clk = clk_in;
	
	-- 2. A saída do módulo é o valor atual armazenado no flip-flop.
	comp_flag = comp_flag_q.q;
	
	-- 3. Lógica que decide o PRÓXIMO estado da flag.
	-- Esta é uma máquina de estados com 3 condições: SET, RESET e HOLD.
	
	-- Condição de SET (Ligar a flag)
	IF menu_in[] == B"11" THEN
		-- Se o Menu 4 for acessado, prepara para ligar a flag no próximo pulso de clock.
		comp_flag_q.d = VCC; -- VCC = Nível lógico '1'
		
	-- Condição de RESET (Desligar a flag)
	ELSE IF (menu_in[] == B"01") | (menu_in[] == B"10") THEN
		-- Se o Menu 2 ou 3 for acessado, prepara para desligar a flag.
		comp_flag_q.d = GND; -- GND = Nível lógico '0'
		
	-- Condição de HOLD (Manter o estado atual)
	ELSE
		-- Em qualquer outro caso (Menu 1, "00"), a flag deve manter seu valor.
		-- Para isso, conectamos a entrada do DFF à sua própria saída.
		comp_flag_q.d = comp_flag_q.q;
		
	END IF;
END;