TITLE "Contador de Década de 4 Dígitos (0-9999)";

-- Este subdesign não precisa de parâmetros, pois sua estrutura é fixa.
SUBDESIGN contador_de_decada
(
	-- ENTRADAS --
	clk_in      : INPUT;  -- Clock principal para a contagem.
	reset_pin   : INPUT;  -- Pino de reset (a borda de subida 0->1 gera o reset).
	comp_flag   : INPUT;  -- Flag de comparação (permissão em '1').
	final_cont  : INPUT;  -- Flag de final de contagem (permissão em '0').
	pausa       : INPUT;  -- Pausa a contagem quando em '1' (permissão em '0').
	
	-- SAÍDAS --
	unidade_out[3..0] : OUTPUT;
	dezena_out[3..0]  : OUTPUT;
	centena_out[3..0] : OUTPUT;
	milhar_out[3..0]  : OUTPUT;
)
VARIABLE
	-- Contadores internos para cada dígito.
	unidade_q[3..0] : DFF;
	dezena_q[3..0]  : DFF;
	centena_q[3..0] : DFF;
	milhar_q[3..0]  : DFF;
	
	-- Registrador de 1 bit para detectar a borda do pino de reset.
	reset_reg       : DFF;
	
	-- Nós lógicos para as condições.
	pode_contar : NODE;
	reset_pulse : NODE; -- NOVO: Pulso de reset de um ciclo.

BEGIN
	-- 1. Sincronização dos clocks.
	unidade_q[].clk = clk_in;
	dezena_q[].clk  = clk_in;
	centena_q[].clk = clk_in;
	milhar_q[].clk  = clk_in;
	reset_reg.clk = clk_in;
	
	-- 2. Conexão das saídas.
	unidade_out[] = unidade_q[].q;
	dezena_out[]  = dezena_q[].q;
	centena_out[] = centena_q[].q;
	milhar_out[]  = milhar_q[].q;
	
	-- 3. Lógica de permissão de contagem (não alterada).
	pode_contar = !pausa & (comp_flag & !final_cont);

	-- 4. Lógica do Detector de Borda para o Reset.
	-- Amostra continuamente o estado de reset_pin.
	reset_reg.d = reset_pin;
	-- Gera um pulso se o estado anterior era '0' e o atual é '1'.
	reset_pulse = !reset_reg.q & reset_pin;

	-- 5. Lógica principal de contagem (usando o pulso de reset).
	IF reset_pulse == VCC THEN
		-- Se o pulso de reset foi detectado, zera todos os dígitos.
		unidade_q[].d = 0;
		dezena_q[].d  = 0;
		centena_q[].d = 0;
		milhar_q[].d  = 0;
	ELSE
		-- Se não houver pulso de reset, verifica se tem permissão para contar.
		IF pode_contar THEN
			-- Lógica de contagem em cascata (não alterada)
			IF unidade_q[].q == 9 THEN
				unidade_q[].d = 0;
			ELSE
				unidade_q[].d = unidade_q[].q + 1;
			END IF;
			
			IF unidade_q[].q == 9 THEN
				IF dezena_q[].q == 9 THEN dezena_q[].d = 0; ELSE dezena_q[].d = dezena_q[].q + 1; END IF;
			ELSE
				dezena_q[].d = dezena_q[].q;
			END IF;
			
			IF (unidade_q[].q == 9) & (dezena_q[].q == 9) THEN
				IF centena_q[].q == 9 THEN centena_q[].d = 0; ELSE centena_q[].d = centena_q[].q + 1; END IF;
			ELSE
				centena_q[].d = centena_q[].q;
			END IF;
			
			IF (unidade_q[].q == 9) & (dezena_q[].q == 9) & (centena_q[].q == 9) THEN
				IF milhar_q[].q == 9 THEN milhar_q[].d = 0; ELSE milhar_q[].d = milhar_q[].q + 1; END IF;
			ELSE
				milhar_q[].d = milhar_q[].q;
			END IF;
		ELSE
			-- Se não houver permissão, mantém o valor.
			unidade_q[].d = unidade_q[].q;
			dezena_q[].d  = dezena_q[].q;
			centena_q[].d = centena_q[].q;
			milhar_q[].d  = milhar_q[].q;
		END IF;
	END IF;
END;