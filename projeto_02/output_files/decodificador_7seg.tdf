TITLE "Decodificador de 7 segmentos (anodo comum)";

-- Declaração do bloco de design
SUBDESIGN decodificador_7seg
(
	bit[3..0]       : INPUT;     -- Entrada de 4 bits (representa os números de 0 a 9)
	segmento[0..6]  : OUTPUT;    -- Saída de 7 bits para os segmentos (a,b,c,d,e,f,g)
)

BEGIN
	-- Tabela Verdade com lógica invertida (ativo em '0' ou GND), para displays de anodo comum.
	
	TABLE
		-- Entrada   => Saída (gfedcba)
		bit[]        => segmento[];
		
		B"0000"      => B"0000001"; -- 0
		B"0001"      => B"1001111"; -- 1
		B"0010"      => B"0010010"; -- 2
		B"0011"      => B"0000110"; -- 3
		B"0100"      => B"1001100"; -- 4
		B"0101"      => B"0100100"; -- 5
		B"0110"      => B"0100000"; -- 6
		B"0111"      => B"0001111"; -- 7
		B"1000"      => B"0000000"; -- 8
		B"1001"      => B"0000100"; -- 9
	END TABLE;
END;