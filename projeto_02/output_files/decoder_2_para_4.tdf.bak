TITLE "Decodificador 2-para-4 para Ativação de Dígitos";

-- Este módulo pega uma entrada de 2 bits e ativa uma das 4 saídas de DIG[1..4].
SUBDESIGN decoder_2_para_4
(
	
	selecao[1..0] : INPUT; -- Entrada de 2 bits, vinda do contador.
	
	digito[4..1]     : OUTPUT; -- Saída de 4 bits. Apenas um bit estará ativo (em '1') por vez.
)
BEGIN
	TABLE

		selecao[]        => digito[];
		
		B"00"      => B"0001"; -- Aciona DIG1
		B"01"      => B"0010"; -- Aciona DIG2
		B"10"      => B"0100"; -- Aciona DIG3
		B"11"      => B"1000"; -- Aciona DIG4
	END TABLE;	
END;