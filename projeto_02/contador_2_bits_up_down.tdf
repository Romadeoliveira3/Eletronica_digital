TITLE "Contador de 2 Bits com Detector de Borda";

-- Este subdesign cria um contador de 2 bits (0-3) que reage
-- a cada clique dos botões, independentemente da velocidade do clock.
SUBDESIGN contador_2_bits_up_down
(
	-- ENTRADAS --
	clk_in        : INPUT;  -- Clock do sistema.
	botaoprox_in  : INPUT;  -- Botão para contar de forma CRESCENTE (UP).
	botaoant_in   : INPUT;  -- Botão para contar de forma DECRESCENTE (DOWN).
	
	-- SAÍDA --
	bit_out[1..0] : OUTPUT; -- SAÍDA para 2 bits.
)
VARIABLE
	-- Registrador principal para 2 bits.
	q[1..0]            : DFF;
	
	-- Registradores para armazenar o estado anterior de cada botão.
	btn1_reg, btn2_reg : DFF;
	
	-- Nós lógicos para os pulsos gerados.
	up_pulse, down_pulse : NODE;

BEGIN
	-- Sincroniza todos os registradores com o mesmo clock.
	q[].clk = clk_in;
	btn1_reg.clk = clk_in;
	btn2_reg.clk = clk_in;
	
	-- Conecta o valor do contador à porta de saída.
	bit_out[] = q[].q;
	
	-- Lógica do Detector de Borda --
	btn1_reg.d = botaoprox_in;
	btn2_reg.d = botaoant_in;
	up_pulse   = btn1_reg.q & !botaoprox_in;
	down_pulse = btn2_reg.q & !botaoant_in;
	
	-- Lógica do Contador (agora baseada nos pulsos) --
	IF up_pulse == VCC THEN
		-- Se um pulso de UP foi detectado, incrementa o contador.
		q[].d = q[].q + 1;
		
	ELSE IF down_pulse == VCC THEN
		-- Senão, se um pulso de DOWN foi detectado, decrementa.
		q[].d = q[].q - 1;
		
	ELSE
		-- Se nenhum pulso ocorreu, mantém o valor atual.
		q[].d = q[].q;
		
	END IF;
END IF;
END;