(text "Seletor de alimentação do display" (rect 2456 88 2852 117)(font "Intel Clear" (font_size 16)(bold)))
(text "Unidade" (rect 2032 144 2126 174)(font "Intel Clear" (font_size 16)))
(text "Dezena" (rect 2032 280 2114 310)(font "Intel Clear" (font_size 16)))
(text "Centena" (rect 2024 400 2114 430)(font "Intel Clear" (font_size 16)))
(text "Milhar" (rect 2048 528 2118 558)(font "Intel Clear" (font_size 16)))
(text "Seletor de dígitos do display" (rect 1896 712 2229 741)(font "Intel Clear" (font_size 16)(bold)))
(text "Decodificador de dígitos do display" (rect 1896 104 2305 133)(font "Intel Clear" (font_size 16)(bold)))
(text "Multiplexador de mostragem do display" (rect 1152 88 1615 117)(font "Intel Clear" (font_size 16)(bold)))
(text "Menu de dígitos" (rect 840 1184 1026 1213)(font "Intel Clear" (font_size 16)(bold)))
(text "As saídas digselx determinam a permissão para que o registrador possa ser alterado," (rect 1160 1448 1662 1467)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "indo de digsel1 para unidade, digsel2 para dezena, digsel3 para centena e digsel4 para milhar." (rect 1160 1464 1722 1483)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "Já as saídas blinkdigx determinam a permissão para que os dígitos no display possam piscar individualmente." (rect 1168 1400 1822 1419)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "indo de blinkdig1 para unidade, blinkdig2 para dezena, blinkdig3 para centena e blinkdig4 para milhar." (rect 1168 1416 1782 1435)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "Este contador é habilitado apenas no menu 2 (seleção de dígitos)." (rect 728 1392 1113 1411)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "Sua função é salvar a posição do último dígito selecionado." (rect 728 1408 1074 1427)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "Comparador" (rect 1888 1160 2031 1189)(font "Intel Clear" (font_size 16)(bold)))
(text "Permissão para início de contagem" (rect 2000 1216 2388 1246)(font "Intel Clear" (font_size 16)))
(text "Esta é uma máquina de estados com 3 condições: SET, RESET e HOLD." (rect 1992 1464 2408 1483)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "Controlador de pausa e reset" (rect 1160 504 1495 533)(font "Intel Clear" (font_size 16)(bold)))
(text "Entradas" (rect 232 104 333 133)(font "Intel Clear" (font_size 16)(bold)))
(text "Saídas" (rect 216 424 291 453)(font "Intel Clear" (font_size 16)(bold)))
(text "Contador de década" (rect 608 96 840 125)(font "Intel Clear" (font_size 16)(bold)))
(text "Registrador up/down" (rect 608 384 853 413)(font "Intel Clear" (font_size 16)(bold)))
(text "Unidade" (rect 768 416 862 446)(font "Intel Clear" (font_size 16)))
(text "Dezena" (rect 768 600 850 630)(font "Intel Clear" (font_size 16)))
(text "Centena" (rect 768 784 858 814)(font "Intel Clear" (font_size 16)))
(text "Milhar" (rect 760 960 830 990)(font "Intel Clear" (font_size 16)))
(text "Ao detectar a chegada ao menu 2, emite um pulso para que o contador de década" (rect 1184 1024 1668 1043)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "e o contador registrador possam ser resetados para um nova contagem naquele cronômetro." (rect 1184 1048 1727 1067)(font "Intel Clear" (color 0 0 0)(font_size 8)))
(text "Reset de nova contagem" (rect 1184 800 1468 829)(font "Intel Clear" (font_size 16)(bold)))
