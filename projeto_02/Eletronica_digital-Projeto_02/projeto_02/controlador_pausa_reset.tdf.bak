TITLE "Controlador de Pausa e Reset";

-- Este subdesign gera um sinal de pausa (toggle) e um pulso de reset
-- com base em cliques de botão, mas apenas quando o menu "11" está ativo.
SUBDESIGN controlador_pausa_reset
(
	-- ENTRADAS --
	clk_in        : INPUT;      -- Clock do sistema.
	menu_in[1..0] : INPUT;      -- Habilita a lógica no estado "11".
	botaoprox_in  : INPUT;      -- Aciona a lógica de pausa (toggle).
	botaoant_in   : INPUT;      -- Aciona o pulso de reset.
	
	-- SAÍDAS --
	pausa_out       : OUTPUT;     -- Saída que alterna entre 0 e 1.
	resetcont_out   : OUTPUT;     -- Saída que gera um pulso momentâneo.
)
VARIABLE
	-- Registradores para o detector de borda de cada botão.
	btn_prox_reg, btn_ant_reg : DFF;
	
	-- Registrador para armazenar e alternar o estado de 'pausa_out'.
	pausa_q                   : DFF;
	
	-- Nós lógicos para os pulsos de 1 ciclo gerados pelos botões.
	prox_pulse, ant_pulse     : NODE;

BEGIN
	-- Sincroniza todos os registradores com o clock.
	pausa_q.clk = clk_in;
	btn_prox_reg.clk = clk_in;
	btn_ant_reg.clk = clk_in;
	
	-- Conecta a saída 'pausa_out' ao valor armazenado no seu registrador.
	pausa_out = pausa_q.q;
	
	-- === Lógica do Detector de Borda ===
	-- Gera um pulso quando cada botão é pressionado (transição de 1 para 0).
	btn_prox_reg.d = botaoprox_in;
	btn_ant_reg.d = botaoant_in;
	prox_pulse = btn_prox_reg.q & !botaoprox_in;
	ant_pulse  = btn_ant_reg.q & !botaoant_in;
	
	-- === Lógica da Saída 'pausa_out' (Toggle) ===
	-- Esta lógica decide qual será o próximo estado da pausa.
	IF menu_in[] != B"11" THEN
		-- Se não estiver no menu 4, força a pausa para '0' (desligada).
		pausa_q.d = GND;
	ELSE
		-- Se estiver no menu 4, verifica o pulso do botão.
		IF prox_pulse == VCC THEN
			-- Se houver um pulso, inverte o estado atual da pausa.
			pausa_q.d = !pausa_q.q;
		ELSE
			-- Se não houver pulso, mantém o estado atual.
			pausa_q.d = pausa_q.q;
		END IF;
	END IF;
	
	-- === Lógica da Saída 'resetcont_out' (Pulso) ===
	-- Esta lógica é combinacional. A saída é '1' apenas se as duas condições
	-- (pulso do botão E menu correto) forem verdadeiras ao mesmo tempo.
	resetcont_out = ant_pulse & (menu_in[] == B"11");
	
END;