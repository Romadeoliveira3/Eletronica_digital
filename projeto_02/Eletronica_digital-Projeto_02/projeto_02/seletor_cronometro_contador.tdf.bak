TITLE "Seletor de Cronômetro com Contador";

-- Este subdesign usa um contador interno up/down para selecionar um de
-- quatro cronômetros no menu "00" e memoriza a seleção nos outros menus.
-- Diferente do seletor_cronometro anterior, o contador é interno, e não sofre alterações dos outros menus.
SUBDESIGN seletor_cronometro_contador
(
	-- ENTRADAS --
	clk_in        : INPUT;      -- Clock do sistema para sincronizar a lógica.
	menu_in[1..0] : INPUT;      -- Seleciona o modo de operação (editar ou memorizar).
	botaoprox_in  : INPUT;      -- Botão para incrementar a seleção (UP).
	botaoant_in   : INPUT;      -- Botão para decrementar a seleção (DOWN).
	
	-- SAÍDAS --
	-- Saídas de controle, apenas uma estará ativa ('1') por vez.
	crono1, crono2, crono3, crono4 : OUTPUT;
)
VARIABLE
	-- Registrador de 4 bits para "lembrar" qual cronômetro está ativo.
	crono_q[4..1]      : DFF;

	-- Registrador de 2 bits para o contador de seleção interno.
	select_q[1..0]     : DFF;
	
	-- Registradores para o detector de borda dos botões.
	btn_prox_reg, btn_ant_reg : DFF;
	
	-- Nós lógicos para os pulsos dos botões.
	prox_pulse, ant_pulse     : NODE;

BEGIN
	-- 1. Sincroniza todos os registradores com o mesmo clock.
	crono_q.clk = clk_in;
	select_q.clk = clk_in;
	btn_prox_reg.clk = clk_in;
	btn_ant_reg.clk = clk_in;
	
	-- 2. Conecta as saídas do módulo ao valor guardado no registrador de estado.
	(crono4, crono3, crono2, crono1) = crono_q[].q;
	
	-- 3. Lógica do Detector de Borda para os Botões.
	-- Gera um pulso de um ciclo quando um botão é pressionado (1->0).
	btn_prox_reg.d = botaoprox_in;
	btn_ant_reg.d = botaoant_in;
	prox_pulse = btn_prox_reg.q & !botaoprox_in;
	ant_pulse  = btn_ant_reg.q & !botaoant_in;

	-- 4. Lógica do Contador de Seleção Interno ('select_q').
	-- Este contador só é alterado quando estamos no menu "00".
	IF (menu_in[] == B"00") THEN
		IF prox_pulse THEN
			select_q[].d = select_q[].q + 1; -- Incrementa (com wrap-around 3->0)
		ELSE IF ant_pulse THEN
			select_q[].d = select_q[].q - 1; -- Decrementa (com wrap-around 0->3)
		ELSE
			select_q[].d = select_q[].q; -- Mantém se não houver clique.
		END IF;
		END IF;
	ELSE
		select_q[].d = select_q[].q; -- Mantém o valor em outros menus.
	END IF;

	-- 5. Lógica de Estado Principal ('crono_q'), agora baseada no contador interno.
	IF menu_in[] == B"00" THEN
		-- Modo de Edição: O próximo estado é determinado pelo valor do contador interno.
		CASE select_q[].q IS
			WHEN B"00" => crono_q[].d = B"0001"; -- Ativa crono1
			WHEN B"01" => crono_q[].d = B"0010"; -- Ativa crono2
			WHEN B"10" => crono_q[].d = B"0100"; -- Ativa crono3
			WHEN B"11" => crono_q[].d = B"1000"; -- Ativa crono4
		END CASE;
	ELSE
		-- Modo de Memória: Mantém a última seleção.
		crono_q[].d = crono_q[].q;
	END IF;
END;