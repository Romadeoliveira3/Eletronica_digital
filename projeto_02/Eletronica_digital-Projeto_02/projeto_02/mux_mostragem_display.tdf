TITLE "Multiplexador de Mostragem para Display";

-- Seleciona entre duas fontes de dados de 4 dígitos
-- (um contador e um registrador) com base no modo de menu.
SUBDESIGN mux_mostragem_display
(
	-- ENTRADAS --
	menu_in[1..0]         : INPUT; -- Chave seletora principal.

	-- Fonte de dados 1: Valores do contador.
	cont_unidade[3..0]    : INPUT;
	cont_dezena[3..0]     : INPUT;
	cont_centena[3..0]    : INPUT;
	cont_milhar[3..0]     : INPUT;

	-- Fonte de dados 2: Valores do registrador de memória.
	reg_unidade[3..0]     : INPUT;
	reg_dezena[3..0]      : INPUT;
	reg_centena[3..0]     : INPUT;
	reg_milhar[3..0]      : INPUT;
	
	-- SAÍDAS --
	-- Saídas que levarão os dados selecionados para os decodificadores.
	und_out[3..0]         : OUTPUT;
	dzn_out[3..0]         : OUTPUT;
	cnt_out[3..0]         : OUTPUT;
	mil_out[3..0]         : OUTPUT;
)
BEGIN
	-- A estrutura CASE seleciona qual grupo de entradas será conectado às saídas.
	CASE menu_in[] IS
	
		-- Se o menu estiver em 00 (contador) ou 11 (não usado, mas agrupado)...
		WHEN B"00" =>
			-- Conecta as saídas diretamente à fonte de dados do CONTADOR.
			und_out[] = cont_unidade[];
			dzn_out[] = cont_dezena[];
			cnt_out[] = cont_centena[];
			mil_out[] = cont_milhar[];
			
		WHEN B"11" =>
			-- Conecta as saídas diretamente à fonte de dados do CONTADOR.
			und_out[] = cont_unidade[];
			dzn_out[] = cont_dezena[];
			cnt_out[] = cont_centena[];
			mil_out[] = cont_milhar[];
			
		-- Para todos os outros casos (01 e 10)...
		WHEN OTHERS =>
			-- Conecta as saídas diretamente à fonte de dados do REGISTRADOR.
			und_out[] = reg_unidade[];
			dzn_out[] = reg_dezena[];
			cnt_out[] = reg_centena[];
			mil_out[] = reg_milhar[];
			
	END CASE;
END;