TITLE "Decodificador de Dígitos";

-- Este subdesign usa flip-flops para memorizar o estado das saídas 'digsel'
-- quando o Menu 3 está selecionado.
SUBDESIGN decodificador_menu_digitos
(
	-- ENTRADAS --
	clk_in          : INPUT;  -- Clock para sincronizar os registradores de memória.
	menu_in[1..0]   : INPUT;  -- Seleciona o modo de operação.
	select_in[1..0] : INPUT;  -- Seleciona a saída no modo de edição.
	
	-- SAÍDAS --
	digsel1, digsel2, digsel3, digsel4 : OUTPUT;
	
	-- NOVAS SAÍDAS --
	blinkdig1, blinkdig2, blinkdig3, blinkdig4 : OUTPUT;
)
VARIABLE
	-- Registradores (DFFs) que irão memorizar o estado das 4 saídas.
	digsel_q[4..1] : DFF;
	
	aux_dig[4..1]  : DFF;

BEGIN
	-- ===================================================================
	-- || LÓGICA ORIGINAL (PARA 'digsel') - NÃO FOI ALTERADA             ||
	-- ===================================================================

	-- 1. Sincroniza os registradores de memória com o clock.
	digsel_q[].clk = clk_in;
	aux_dig[].clk  = clk_in;
	
	-- 2. Conecta as saídas do módulo diretamente ao valor guardado nos registradores.
	digsel1 = digsel_q[1].q;
	digsel2 = digsel_q[2].q;
	digsel3 = digsel_q[3].q;
	digsel4 = digsel_q[4].q;
	
	-- 3. O CASE agora controla o PRÓXIMO estado de AMBOS os registradores.
	CASE menu_in[] IS
		WHEN B"01" =>
			digsel_q[].d = B"0000";
			CASE select_in[] IS
				WHEN B"00" => aux_dig[].d = B"0001";
								  (blinkdig4, blinkdig3, blinkdig2, blinkdig1) = B"0001";
				WHEN B"01" => aux_dig[].d = B"1000";
								  (blinkdig4, blinkdig3, blinkdig2, blinkdig1) = B"1000";
				WHEN B"10" => aux_dig[].d = B"0100";
								  (blinkdig4, blinkdig3, blinkdig2, blinkdig1) = B"0100";
				WHEN B"11" => aux_dig[].d = B"0010";
								  (blinkdig4, blinkdig3, blinkdig2, blinkdig1) = B"0010";
			END CASE;
			
		WHEN B"10" =>
			digsel_q[].d = aux_dig[].q;
			aux_dig[].d = aux_dig[].q;
			(blinkdig4, blinkdig3, blinkdig2, blinkdig1) = B"0000";
			
		WHEN OTHERS =>
			digsel_q[].d = B"0000";
			aux_dig[].d = B"0000";
			(blinkdig4, blinkdig3, blinkdig2, blinkdig1) = B"0000";
			
	END CASE;

END;