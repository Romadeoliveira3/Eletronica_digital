TITLE "Multiplexador de Display 4-Dígitos";

-- Este módulo seleciona qual conjunto de segmentos (unidade, dezena, etc.)
-- será enviado para a saída, com base no sinal de seleção.
SUBDESIGN mux_display_4digitos
(
	-- ENTRADAS --
	
	-- Sinal de seleção de 4 bits (ativo em 0).
	-- Ex: B"1110" seleciona a unidade, B"1101" a dezena, etc.
	selecao[3..0]         : INPUT;
	
	-- Dados dos segmentos para cada dígito (vindo de decodificadores BCD->7seg).
	unidade_seg[6..0]     : INPUT;
	dezena_seg[6..0]      : INPUT;
	centena_seg[6..0]     : INPUT;
	milhar_seg[6..0]      : INPUT;
	
	-- SAÍDA --
	
	-- Saída final de 7 bits que vai para os pinos do display.
	segmento_out[6..0]    : OUTPUT;
)
BEGIN
	-- A estrutura CASE funciona como uma chave seletora digital.
	-- Ela verifica o valor do sinal de 'selecao' para decidir qual
	-- conjunto de dados de segmento deve ser passado para a saída.
	CASE selecao[] IS
	
		-- QUANDO o dígito da UNIDADE estiver ativo (selecao[0] = 0)...
		WHEN B"1110" =>
			-- ...a saída do multiplexador recebe os dados dos segmentos da UNIDADE.
			segmento_out[] = unidade_seg[];
			
		-- QUANDO o dígito da DEZENA estiver ativo (selecao[1] = 0)...
		WHEN B"1101" =>
			-- ...a saída do multiplexador recebe os dados dos segmentos da DEZENA.
			segmento_out[] = dezena_seg[];
			
		-- QUANDO o dígito da CENTENA estiver ativo (selecao[2] = 0)...
		WHEN B"1011" =>
			-- ...a saída do multiplexador recebe os dados dos segmentos da CENTENA.
			segmento_out[] = centena_seg[];
			
		-- QUANDO o dígito do MILHAR estiver ativo (selecao[3] = 0)...
		WHEN B"0111" =>
			-- ...a saída do multiplexador recebe os dados dos segmentos do MILHAR.
			segmento_out[] = milhar_seg[];
			
		-- CASO PADRÃO (Segurança): Se o sinal de seleção for inválido
		-- (nenhum ou mais de um dígito ativo), apaga todos os segmentos.
		WHEN OTHERS =>
			-- Para anodo comum (ativo em 0), apagar significa mandar '1' para todos.
			segmento_out[] = B"1111111";
			
	END CASE;
END;