TITLE "Controlador de Display com Blink Corrigido";

-- Este módulo implementa a multiplexação de 4 dígitos e uma lógica de blink
-- correta, onde o blink sobrepõe a seleção sem interrompê-la.
SUBDESIGN decoder_2_para_4
(
	-- ENTRADAS --
	selecao[1..0]    : INPUT; -- Entrada de 2 bits para selecionar o dígito.
	
	-- Novos clocks de blink com frequências diferentes
	clk_blinkdig     : INPUT; -- Clock para o blink individual dos dígitos.
	clk_blinkglobal  : INPUT; -- Clock para o blink global do display.
	
	-- Entradas de controle para o blink
	blinkdig1, blinkdig2, blinkdig3, blinkdig4 : INPUT;
	final_cont       : INPUT; -- Ativa o blink global.
	
	-- SAÍDA --
	alterna[3..0]    : OUTPUT; -- Saída de 4 bits para os comuns dos dígitos (ativa em '0').
)
VARIABLE
	-- Nós internos para lógica intermediária
	decoder_out[3..0] : NODE; -- Armazena a saída do decodificador padrão.
	force_off[3..0]   : NODE; -- "Mapa" que indica quando forçar um dígito a apagar.

BEGIN
	-- PASSO 1: Decodifica a seleção para determinar qual dígito estaria normalmente ativo.
	-- Saída ativa em '0'. Para o vetor [3..0], B"1110" ativa o bit 0.
	TABLE
		selecao[]      => decoder_out[];
		B"00"          => B"1110"; -- Prepara para ativar alterna[0]
		B"01"          => B"1101"; -- Prepara para ativar alterna[1]
		B"10"          => B"1011"; -- Prepara para ativar alterna[2]
		B"11"          => B"0111"; -- Prepara para ativar alterna[3]
	END TABLE;

	-- PASSO 2: Lógica de "Forçar Apagamento".
	-- Um dígito é forçado a apagar se houver uma condição de blink E o respectivo clock
	-- estiver na fase de "desligado" (assumindo que clk_blink='0' é desligado).
	force_off[3] = (final_cont & !clk_blinkglobal) OR (blinkdig1 & !clk_blinkdig);
	force_off[2] = (final_cont & !clk_blinkglobal) OR (blinkdig2 & !clk_blinkdig);
	force_off[1] = (final_cont & !clk_blinkglobal) OR (blinkdig3 & !clk_blinkdig);
	force_off[0] = (final_cont & !clk_blinkglobal) OR (blinkdig4 & !clk_blinkdig);

	-- PASSO 3: MUX final para cada saída.
	-- O laço FOR...GENERATE cria essa lógica para cada um dos 4 bits.
	FOR i IN 0 TO 3 GENERATE
		-- A condição de apagar tem prioridade.
		IF force_off[i] == VCC THEN
			-- Se forçado a apagar, a saída vai para '1' (desligado).
			alterna[i] = VCC;
		ELSE
			-- Senão, a saída segue o resultado normal da multiplexação.
			alterna[i] = decoder_out[i];
		END IF;
	END GENERATE;
END;