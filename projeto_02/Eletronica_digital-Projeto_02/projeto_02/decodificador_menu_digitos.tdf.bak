TITLE "Decodificador de Dígitos";

-- Este subdesign usa flip-flops para memorizar o estado das saídas 'digsel'
-- quando o Menu 3 está selecionado.
SUBDESIGN decodificador_menu_digitos
(
	-- ENTRADAS --
	clk_in          : INPUT;  -- Clock para sincronizar os registradores de memória.
	menu_in[1..0]   : INPUT;  -- Seleciona o modo de operação.
	select_in[1..0] : INPUT;  -- Seleciona a saída no modo de edição.
	
	-- SAÍDAS --
	digsel1, digsel2, digsel3, digsel4 : OUTPUT;
)
VARIABLE
	-- Registradores (DFFs) que irão memorizar o estado das 4 saídas.
	digsel_q[4..1] : DFF;

BEGIN
	-- 1. Sincroniza os registradores de memória com o clock.
	digsel_q[].clk = clk_in;
	
	-- 2. Conecta as saídas do módulo diretamente ao valor guardado nos registradores.
	(digsel4, digsel3, digsel2, digsel1) = digsel_q[].q;

	-- 3. O CASE agora controla o PRÓXIMO estado a ser carregado nos registradores.
	CASE menu_in[] IS
	
		-- Menu 2 ("01"): Modo de Edição.
		-- As saídas podem ser alteradas conforme a seleção.
		WHEN B"01" =>
			CASE select_in[] IS
				WHEN B"00" => digsel_q[].d = B"0001"; -- Prepara '1' para digsel1.
				WHEN B"01" => digsel_q[].d = B"1000"; -- Prepara '1' para digsel4.
				WHEN B"10" => digsel_q[].d = B"0100"; -- Prepara '1' para digsel3.
				WHEN B"11" => digsel_q[].d = B"0010"; -- Prepara '1' para digsel2.
			END CASE;
			
		-- Menu 3 ("10"): Modo de Memória.
		-- As saídas são "congeladas" e não podem ser alteradas.
		WHEN B"10" =>
			-- Esta linha instrui os registradores a recarregarem o valor
			-- que eles já possuem, mantendo a saída estável.
			digsel_q[].d = digsel_q[].q;
			
		-- Outros Menus (00 e 11): Modo de Reset.
		-- Zera o valor memorizado.
		WHEN OTHERS =>
			digsel_q[].d = B"0000";
			
	END CASE;
END;