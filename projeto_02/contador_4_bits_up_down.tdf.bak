TITLE "Contador de 4 Bits Up/Down";

-- Este subdesign cria um contador de 4 bits (0-15).
-- Assume botões ativos em nível baixo ('0').
SUBDESIGN contador_4_bits_up_down
(
	-- ENTRADAS --
	clk_in      : INPUT;  -- Clock que dita o ritmo da contagem.
	botao1_in   : INPUT;  -- Botão para contar de forma CRESCENTE (UP).
	botao2_in   : INPUT;  -- Botão para contar de forma DECRESCENTE (DOWN).
	
	-- SAÍDA --
	bit_out[3..0] : OUTPUT; -- Saída de 4 bits com o valor da contagem.
)
VARIABLE
	-- Registrador de 4 bits para armazenar o valor atual do contador.
	q[3..0] : DFF;

BEGIN
	-- Sincroniza o contador com o clock de entrada.
	q[].clk = clk_in;
	
	-- Conecta o valor do contador diretamente à porta de saída.
	bit_out[] = q[].q;
	
	-- Lógica de decisão para incrementar, decrementar ou manter o valor.
	IF botao1_in == '0' THEN
		-- Se o botão 1 estiver pressionado, incrementa o contador.
		q[].d = q[].q + 1;
		
	ELSE IF botao2_in == '0' THEN
		-- Senão, se o botão 2 estiver pressionado, decrementa o contador.
		q[].d = q[].q - 1;
		
	ELSE
		-- Se nenhum botão estiver pressionado, mantém o valor atual.
		q[].d = q[].q;
		
	END IF;
END IF;
END;