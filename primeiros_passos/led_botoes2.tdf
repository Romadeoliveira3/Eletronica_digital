-- Arquivo: led_botoes2.tdf
-- Descrição: Botão multifunção
-- Autor: Malki-çedheq Benjamim
-- Data: 04/02/2022
INCLUDE "gera_pulso.inc";
SUBDESIGN led_botoes2 (
	key[1] 	 : INPUT;
	clock		 : INPUT; --50MHz
	led[4..1] : OUTPUT;
)
VARIABLE
	fsm : MACHINE WITH STATES (s0,s1,s2,s3);
	gp : gera_pulso; --instancia do gera pulso
BEGIN 

	gp.pb_in 	= key[1];
	gp.clk_in	= clock;

	fsm.clk = clock;  --50MHz	
	CASE fsm IS
		WHEN s0 => 
			led[] = B"1011";
			IF (gp.pulso_out) THEN fsm = s1;	
			ELSE fsm = s0;
			END IF;			
		WHEN s1 => 
			led[] = B"1110";
			IF (gp.pulso_out) THEN fsm = s2; 
			ELSE fsm = s1;
			END IF;
		WHEN s2 =>
			led[] = B"1101";
			IF (gp.pulso_out) THEN fsm = s3;
			ELSE fsm = s2;
			END IF;
		WHEN s3 =>
			led[] = B"0111";
			IF (gp.pulso_out) THEN fsm = s0;
			ELSE fsm = s3;
			END IF;
	END CASE;	
END;